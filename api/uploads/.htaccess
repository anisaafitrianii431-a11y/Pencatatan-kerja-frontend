# Cegah eksekusi script PHP di folder upload (K-04)
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|exe)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Matikan engine PHP jika modul terpasang
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI

