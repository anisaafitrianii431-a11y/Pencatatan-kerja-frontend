# Cegah eksekusi script PHP di folder upload (K-04)
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|exe)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Matikan engine PHP jika modul terpasang
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^absensi_([a-zA-Z0-9_\-]+)\.(jpg|jpeg|png|webp)$ absensi/absensi_$1.$2 [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(kwitansi|nota)_([a-zA-Z0-9_\-]+)\.(jpg|jpeg|png|webp|pdf)$ kwitansi/$1_$2.$3 [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^dana_([a-zA-Z0-9_\-]+)\.(jpg|jpeg|png|webp)$ dana_kantor/dana_$1.$2 [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^kembali_([a-zA-Z0-9_\-]+)\.(jpg|jpeg|png|webp)$ pengembalian/kembali_$1.$2 [L]
</IfModule>

